# Plantilla de configuración de la base de datos.
# Copia este archivo a .env y completa tus datos reales.
# El archivo .env NO se sube al repositorio (está en .gitignore).
#
# Nota: los comentarios van en su propia línea (con # al inicio).

# Servidor de la base de datos (en InfinityFree suele ser sqlXXX.infinityfree.com)
DB_HOST=localhost

# Nombre de la base de datos
DB_NAME=agenda_contactos

# Usuario de MySQL
DB_USER=root

# Contraseña de MySQL (puede quedar vacía en local)
DB_PASS=